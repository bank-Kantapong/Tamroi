# ============================================================================
# TAMROI (ตามรอย) — Environment Variables Example (Phase 1 MVP)
# Copy this file to `.env.local` for local development.
# Never commit real credentials or `.env.local` to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Data Storage Mode
# ----------------------------------------------------------------------------
# Options: "auto" | "local" | "supabase"
# - "auto" (default): Uses Supabase PostgreSQL if NEXT_PUBLIC_SUPABASE_URL and
#   SUPABASE_SERVICE_ROLE_KEY are provided; otherwise uses the local persistent
#   JSON database at ./data/tamroi-db.json (seeded from sample trips).
# - "local": Forces local file-backed database ($0, zero cloud setup required).
# - "supabase": Requires Supabase environment variables below.
TAMROI_DATA_BACKEND=auto

# Optional override path for the local file-backed database
# TAMROI_LOCAL_DB_PATH=./data/tamroi-db.json

# ----------------------------------------------------------------------------
# 2. Supabase Free Tier Configuration (Optional for local dev, recommended for cloud deploy)
# ----------------------------------------------------------------------------
# Create a free project at https://supabase.com and run:
# supabase/migrations/001_init_tamroi_phase1.sql in the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key used exclusively in server-side admin mutations:
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# 3. Admin Authentication (Required for /admin access)
# ----------------------------------------------------------------------------
# No public self-registration exists in Phase 1. Configure your single admin
# credentials and a random 32+ character session secret below:
ADMIN_EMAIL=admin@tamroi.local
ADMIN_PASSWORD=change-this-admin-password-before-deploying
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters-secret-key

# ----------------------------------------------------------------------------
# 4. Map Tile Configuration (Free-First OpenStreetMap Compatible)
# ----------------------------------------------------------------------------
# Default uses OpenStreetMap standard tiles. For production traffic, consider a
# dedicated free-tier OSM tile provider (e.g., Stadia Maps / MapTiler / Protomaps)
# and review tile usage policies in README.md.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors

